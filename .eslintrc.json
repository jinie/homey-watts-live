{
  "extends": "athom/homey-app",
  "rules": {
    "quotes": [ 2, "single" ],
    "node/no-missing-import": ["error", {
      "resolvePaths": ["./lib", "./types", "./drivers/watts-live"],
      "tryExtensions": [".ts"],
      "allowModules": ["homey"]
  }]
  },
  "overrides": [
    {
      "files": ["{lib,types,drivers/watts-live}/*.{ts,js}"],
      "excludedFiles": ["node_modules/**/*"],
      "rules": {
        "quotes": [ 2, "single" ]
      }
    },
    {
      "files": ["**/*.ts"],
      "rules": {
        "import/no-unresolved": "off",
        "import/extensions": "off",
        "node/no-unsupported-features/es-syntax": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "consistent-return": "off",
        "homey-app/global-timers": "off"
      }
    },
    {
      "files": ["types/MeterReading.ts"],
      "rules": {
        "camelcase": "off"
      }
    },
    {
      "files": ["types/*.ts"],
      "rules": {
        "semi": "off",
        "no-extra-semi": "off"
      }
    },
    {
      "files": ["drivers/watts-live/pair/*.js"],
      "globals": {
        "Homey": "readonly"
      },
      "rules": {
        "no-console": "off",
        "func-names": "off",
        "prefer-arrow-callback": "off",
        "consistent-return": "off",
        "space-before-function-paren": "off",
        "no-multi-spaces": "off",
        "prefer-destructuring": "off"
      }
    }
  ]
}

    "moduleResolution": "NodeNext",
    "strict": false,
    "allowJs": true,
    "outDir": ".homeybuild/",
    "paths": {
      "lib/*": ["./lib/*"],
      "types/*": ["./types/*"],
      "drivers/watts-live": ["./drivers/watts-live/*"]
    }
  }
}
